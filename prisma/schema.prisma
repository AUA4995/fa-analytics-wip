// FA Analytics — Prisma schema
// Outside systems (Xero, WMS, Front, Dyspatch) are READ-ONLY for this app: their tables are a local mirror;
// everything else is app-owned state. Foundation copied from the FA Accounts Hub (login, users, company, Xero link).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SyncKind {
  FULL
  INCREMENTAL
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model XeroConnection {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  tenantName     String
  /// Encrypted at rest (AES-256-GCM, key = TOKEN_ENCRYPTION_KEY)
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  scopes         String
  lastFullSyncAt DateTime?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model SyncRun {
  id         String     @id @default(cuid())
  kind       SyncKind
  status     SyncStatus @default(RUNNING)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  stats      Json?
  error      String?
}

/// Single row ("default"). Branding and the people the app works for — editable in Settings.
model Company {
  id                 String   @id @default("default")
  name               String
  shortName          String
  /// The person who runs day-to-day accounts (digests are addressed to them)
  accountHolderName  String?
  accountHolderEmail String?
  /// Primary brand colour: buttons, links, highlights (tints derived in CSS)
  primaryColour      String   @default("#1F54EE")
  timezone           String   @default("Australia/Sydney")
  /// Logo for light backgrounds (dark artwork) and dark backgrounds (light artwork)
  logoLight          Bytes?
  logoLightMime      String?
  logoDark           Bytes?
  logoDarkMime       String?
  updatedAt          DateTime @updatedAt
  /// Branding (R1-shell): dark accent — lead summary cards, selected states, email header
  accentColour       String   @default("#010028")
  /// Branding: body text colour
  textColour         String   @default("#14132E")
  /// Branding: square logo mark for the collapsed menu rail (optional; bundled default otherwise)
  logoMark           Bytes?
  logoMarkMime       String?
}

/// Key/value app settings (thresholds, Front channel, etc.)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  USER
  /// Exactly one (Batch 2 item 1): above ADMIN — only the owner makes/removes admins, connects Xero/Front/AI,
  /// resets 2FA and transfers ownership. Enforced in src/app/settings/user-actions.ts + a partial unique index.
  OWNER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  /// scrypt$N$r$p$salt$hash (see src/lib/auth/password.ts)
  passwordHash String
  role         UserRole  @default(USER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  /// Left menu pinned open (true) or collapsed to the icon rail (false)
  menuPinned   Boolean   @default(true)
  /// Look of the app for this person: null = follow the device (system), "light" or "dark"
  theme        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Batch 2 (b2-auth): null = invited, no password yet (passwordHash is "" until they use the invite link)
  passwordSetAt DateTime?
  /// TOTP secret, encrypted at rest (src/lib/auth/secrets.ts). Set while enrolling; totpEnabledAt marks it confirmed.
  totpSecret    String?
  totpEnabledAt DateTime?
  /// Last accepted 30-second step — a code can't be used twice
  totpLastStep  Int?
  /// Hashed single-use backup codes (10 at enrolment; used ones are removed)
  backupCodes   String[]  @default([])

  sessions   Session[]
  authTokens AuthToken[]
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the cookie token — the raw token is never stored
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  /// Batch 2: when the 2FA step was completed. null = password OK, code still needed (short-lived pending session).
  twoFactorAt     DateTime?
  /// code | backup | device | enrolled
  twoFactorMethod String?

  @@index([userId])
}

/// Xero chart of accounts (replaced each sync).
model XeroAccount {
  id        String   @id @default(cuid())
  xeroId    String   @unique
  code      String?
  name      String
  type      String
  class     String?
  status    String?
  taxType   String?
  updatedAt DateTime @updatedAt

  @@index([code])
}

/// Every Claude API call (or skipped call) — feeds Settings → AI models and budget.
model AiCallLog {
  id           String   @id @default(cuid())
  job          String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  ok           Boolean
  error        String?
  /// What the call was about, e.g. a Front conversation id
  ref          String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([job, createdAt])
}

enum AuthTokenPurpose {
  /// "Set your password" link for a new user (7 days)
  INVITE
  /// Password reset link (2 hours)
  RESET
  /// Owner's Approve / Decline links for an access request (7 days)
  ACCESS_APPROVE
  /// Emergency owner recovery (npm run owner:recover): new password + set up 2FA again (2 hours)
  TWO_FACTOR_RESET
}

/// One-time links sent by email. Only the SHA-256 of the token is stored; single use (usedAt) and expiring.
model AuthToken {
  id              String           @id @default(cuid())
  purpose         AuthTokenPurpose
  tokenHash       String           @unique
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessRequestId String?
  accessRequest   AccessRequest?   @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  usedAt          DateTime?
  createdById     String?
  createdAt       DateTime         @default(now())

  @@index([userId, purpose])
  @@index([accessRequestId])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

/// "Request access" from the login page (company email domain only). The owner approves or declines.
model AccessRequest {
  id            String              @id @default(cuid())
  name          String
  email         String
  reason        String
  status        AccessRequestStatus @default(PENDING)
  ip            String?
  createdAt     DateTime            @default(now())
  decidedAt     DateTime?
  decidedByName String?
  /// Role given on approval
  role          UserRole?
  /// User created on approval
  userId        String?

  tokens AuthToken[]

  @@index([status, createdAt])
  @@index([email])
}

/// Fixed-window rate limits for login, 2FA code, forgot password and request access (key = action + IP/email/user).
model AuthRateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

/// Last success / last error per connection (xero | front | ai) so Settings → Connections survives restarts.
model IntegrationStatus {
  key           String    @id
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  /// Plain-words classification (src/lib/integrations/errors.ts), e.g. xero_login_expired
  errorCode     String?
  errorStatus   Int?
  /// Raw message (shown only as detail under the plain reason)
  errorMessage  String?
  /// When the Hub will try again (Xero timeouts)
  nextRetryAt   DateTime?
  /// Front: { [permission]: { ok: boolean, at: ISO, kind: "read" | "write", detail?: string } }
  checks        Json?
  checkedAt     DateTime?
  updatedAt     DateTime  @updatedAt
}

// =====================================================================================
// Chunk 2 — cost model settings. Every edit is written to ChangeLog (who, when, old → new, why).
// =====================================================================================

enum ActorType {
  USER
  API_KEY
  SYNC
}

/// One row per changed value (brief §12 "Logs on every editable value"). entity + entityId + field identify the value.
model ChangeLog {
  id        String    @id @default(cuid())
  entity    String
  entityId  String
  field     String
  oldValue  Json?
  newValue  Json?
  reason    String?
  actorType ActorType @default(USER)
  /// User name, API key name or sync source (e.g. "Thomax sync")
  actorName String
  at        DateTime  @default(now())

  @@index([entity, entityId, field, at])
  @@index([at])
}

/// Warehouse sites. Separate cost pools and utilisation per site (brief §6, provisional B).
model Site {
  key             String   @id
  name            String
  /// WMS warehouse code(s), e.g. SYD01 = Parramatta
  wmsCodes        String[] @default([])
  /// Owned site → no rent in Xero; a notional monthly rent keeps its clients from looking cheaper (brief §6)
  owned           Boolean  @default(false)
  notionalRent    Decimal? @db.Decimal(12, 2)
  palletPositions Int?
  /// Share of paid floor time available for activities (0–1). Start 0.85, later measured from the WMS.
  labourUtil      Decimal  @default(0.85) @db.Decimal(5, 4)
  /// Pallet positions used ÷ total (0–1); floor-stacked pallets count as used
  spaceUtil       Decimal? @db.Decimal(5, 4)
  sortOrder       Int      @default(0)
  updatedAt       DateTime @updatedAt
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ONE_OFF
}

enum ClientType {
  B2C
  B2B
  MIXED
}

/// Settings → Clients (brief §14). IDs link the same client across systems.
model Client {
  id                 String       @id @default(cuid())
  name               String
  shortName          String?
  status             ClientStatus @default(ACTIVE)
  type               ClientType   @default(B2C)
  /// Site keys the client is served from
  sites              String[]     @default([])
  xeroContactId      String?      @unique
  /// Dyspatch Customer ID = WMS tenant ID
  dyspatchCustomerId String?
  thomaxTenantId     String?
  p3lClientId        String?
  logiwaClientId     String?
  frontDomains       String[]     @default([])
  clmContractRef     String?
  /// Contract renewal date (from CLM once connected; entered here until then)
  renewalDate        DateTime?    @db.Date
  weeklyMinimum      Decimal?     @db.Decimal(12, 2)
  /// Weekly minimum applies after this date (levy-free period)
  levyUntil          DateTime?    @db.Date
  /// Share of orders packed on the CMC CartonWrap (0–1); the rest are packed by hand
  cmcShare           Decimal?     @db.Decimal(5, 4)
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  allocations StaffAllocation[]

  @@index([status])
}

enum PoolKind {
  LABOUR
  OVERHEAD
}

/// Cost pools (brief §6). Labour pools are per site; overheads spread by a driver.
model CostPool {
  key         String   @id
  name        String
  kind        PoolKind
  /// Site key for site-specific pools; null = shared
  site        String?
  /// MINUTES | LABOUR_MINUTES | PALLET_WEEKS | PALLET_MOVES | ORDERS | ORDERS_PACKED | MACHINE_ORDERS | REVENUE
  driver      String
  description String?
  /// Practical capacity per month in driver units (e.g. orders the CMC can wrap). Empty = no capacity concept:
  /// the pool is fully spread over what was used (TDABC = Full absorption for it).
  capacity    Decimal? @db.Decimal(14, 2)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  accounts XeroAccountMap[]
}

enum MinutesBasis {
  ESTIMATE
  WMS
  TIME_STUDY
}

/// The standard services / charge codes (FA charge code catalogue). Minutes drive labour cost (TDABC).
model Service {
  code         String       @id
  name         String
  /// Billing unit, e.g. order, unit, carton, pallet, pallet-week
  unit         String
  /// Labour pool the minutes are priced from (by site at run time); null = no labour
  poolKind     String?
  minutes      Decimal?     @db.Decimal(10, 3)
  minutesBasis MinutesBasis @default(ESTIMATE)
  billable     Boolean      @default(true)
  /// ORDER = one per order (counts orders) · PACK_MANUAL / PACK_CMC = packing method, costed per order with the
  /// client's CMC share (not billed separately)
  role         String?
  /// Overhead drivers per unit, e.g. { "equip": 1 } = one pallet move per unit
  overheads    Json         @default("{}")
  active       Boolean      @default(true)
  sortOrder    Int          @default(0)
  updatedAt    DateTime     @updatedAt
}

/// Settings → Mapping: Xero account → cost pool (or excluded / passed through).
model XeroAccountMap {
  accountCode String    @id
  accountName String?
  poolKey     String?
  pool        CostPool? @relation(fields: [poolKey], references: [key])
  /// Expense accounts: INCLUDE (cost in its pool) | PAYROLL (wages / super — taken from Xero Payroll instead) |
  /// EXCLUDE (not an operating cost) | REBILLED. Income accounts: INCLUDE (processing revenue) | EXCLUDE (postage etc.)
  treatment   String    @default("INCLUDE")
  /// EXPENSE | INCOME (from the Xero account type)
  side        String    @default("EXPENSE")
  note        String?
  updatedAt   DateTime  @updatedAt
}

/// Settings → Mapping: WMS charge codes (per system, optionally per tenant) → standard service code.
model WmsCodeMap {
  id          String   @id @default(cuid())
  /// THOMAX | P3L | LOGIWA
  source      String
  /// Tenant / client ID in that WMS; "" = every tenant
  tenant      String   @default("")
  wmsCode     String
  serviceCode String
  note        String?
  updatedAt   DateTime @updatedAt

  @@unique([source, tenant, wmsCode])
}

enum CostBehaviour {
  FIXED
  VARIABLE
}

/// Settings → Suppliers (analytics view, brief §14).
model Supplier {
  id              String        @id @default(cuid())
  name            String
  xeroContactId   String?       @unique
  poolKey         String?
  site            String?
  behaviour       CostBehaviour @default(FIXED)
  /// Passed through to a client (rebilled) → excluded from FA cost
  rebilled        Boolean       @default(false)
  expectedMonthly Decimal?      @db.Decimal(12, 2)
  notes           String?
  updatedAt       DateTime      @updatedAt
}

enum StaffType {
  PERMANENT
  CASUAL
  AGENCY
}

/// Settings → Staff & allocation (brief §14).
model Staff {
  id             String    @id @default(cuid())
  name           String
  /// smi | par | both
  site           String    @default("smi")
  position       String?
  /// floor | csr | supervisor | admin
  pool           String    @default("floor")
  type           StaffType @default(PERMANENT)
  xeroEmployeeId String?   @unique
  thomaxCode     String?
  p3lCode        String?
  logiwaCode     String?
  startDate      DateTime? @db.Date
  endDate        DateTime? @db.Date
  updatedAt      DateTime  @updatedAt

  allocations StaffAllocation[]
}

enum AllocationSource {
  MANUAL
  WMS
}

/// Share of a person's time per client (0–100). Floor staff from the WMS, others manual. Total per person ≤ 100.
model StaffAllocation {
  staffId  String
  staff    Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  clientId String
  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pct      Decimal          @db.Decimal(5, 2)
  source   AllocationSource @default(MANUAL)

  @@id([staffId, clientId])
}

// =====================================================================================
// Chunk 3 — data sources (local read-only copies of Xero, the WMS and Front)
// =====================================================================================

/// One sync / import run per source (xero, front, thomax, p3l-file, logiwa …) with what it read.
model SourceRun {
  id         String     @id @default(cuid())
  source     String
  /// e.g. "nightly", "manual", "backfill 2021-03", "file Thomax_orders_Sep.csv"
  label      String
  status     SyncStatus @default(RUNNING)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  stats      Json?
  error      String?
  /// Who started it (null = schedule)
  startedBy  String?

  @@index([source, startedAt])
}

// ---------- WMS volumes ----------

/// A file uploaded from a WMS (Thomax export, 3PLWMS export …) or one API page batch. Lines keep a link to it.
model VolumeImport {
  id         String    @id @default(cuid())
  /// THOMAX | P3L | LOGIWA
  source     String
  /// CHARGES (date, tenant, charge code, quantity) | ORDERS (order, date, tenant, SKUs, units)
  kind       String
  fileName   String?
  /// sha256 of the file — the same file can't be loaded twice
  checksum   String?   @unique
  /// Column mapping used (header → field), remembered per source + kind for next time
  mapping    Json?
  rows       Int       @default(0)
  dateFrom   DateTime? @db.Date
  dateTo     DateTime? @db.Date
  /// Lines replaced from an earlier import on overlap (count)
  replaced   Int       @default(0)
  uploadedBy String?
  createdAt  DateTime  @default(now())

  lines  VolumeLine[]
  orders OrderFact[]
}

/// Billable activity per day per tenant per WMS charge code (summed). The standard service code comes from mapping.
model VolumeLine {
  id         String       @id @default(cuid())
  importId   String
  import     VolumeImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  source     String
  date       DateTime     @db.Date
  tenant     String
  wmsCode    String
  /// Warehouse code if the export has it (SYD01 / SYD02); "" when not given
  warehouse  String       @default("")
  quantity   Decimal      @db.Decimal(14, 3)

  @@unique([source, tenant, date, wmsCode, warehouse])
  @@index([date])
  @@index([tenant, date])
}

/// One order (for workload: SKUs per order, units per order, B2B/B2C, weekday). From WMS order exports or the API.
model OrderFact {
  id        String       @id @default(cuid())
  importId  String?
  import    VolumeImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  source    String
  orderRef  String
  date      DateTime     @db.Date
  tenant    String
  warehouse String?
  /// Distinct SKUs on the order
  skus      Int
  units     Decimal      @db.Decimal(12, 2)
  /// WMS order type if exported (e.g. B2B)
  orderType String?

  @@unique([source, orderRef])
  @@index([tenant, date])
  @@index([date])
}

// ---------- Xero (read-only mirror) ----------

model XeroContact {
  xeroId     String   @id
  name       String
  email      String?
  isCustomer Boolean  @default(false)
  isSupplier Boolean  @default(false)
  status     String?
  updatedAt  DateTime @updatedAt
}

/// Sales invoices (ACCREC) and credit notes to clients — what was billed, line by line (for leakage and revenue).
model XeroSale {
  xeroId    String   @id
  /// INVOICE | CREDIT
  kind      String
  number    String?
  reference String?
  contactId String
  date      DateTime @db.Date
  status    String
  total     Decimal  @db.Decimal(14, 2)
  dueDate   DateTime? @db.Date
  /// inc GST, what the client still owes (0 for credit notes)
  amountDue Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt

  lines XeroSaleLine[]

  @@index([contactId, date])
  @@index([date])
}

model XeroSaleLine {
  id          String   @id @default(cuid())
  saleId      String
  sale        XeroSale @relation(fields: [saleId], references: [xeroId], onDelete: Cascade)
  description String?
  itemCode    String?
  accountCode String?
  quantity    Decimal? @db.Decimal(14, 4)
  unitAmount  Decimal? @db.Decimal(14, 4)
  /// Ex GST, negative on credit notes
  amount      Decimal  @db.Decimal(14, 2)

  @@index([saleId])
  @@index([itemCode])
}

/// Profit & loss by month by account (Xero Reports/ProfitAndLoss). Re-read for open months; closed months kept.
model XeroPnl {
  month       String
  accountId   String
  accountCode String?
  accountName String
  /// Income | Less Cost of Sales | Less Operating Expenses | Other Income …
  section     String
  amount      Decimal  @db.Decimal(14, 2)
  updatedAt   DateTime @updatedAt

  @@id([month, accountId])
}

// ---------- Xero Payroll AU ----------

model PayrollEmployee {
  xeroId      String    @id
  firstName   String
  lastName    String
  status      String?
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  updatedAt   DateTime  @updatedAt
}

model PayRun {
  xeroId      String   @id
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  paymentDate DateTime @db.Date
  status      String
  updatedAt   DateTime @updatedAt

  slips Payslip[]
}

/// One employee's pay in one pay run: what drives labour cost (gross, super, hours).
model Payslip {
  xeroId     String   @id
  payRunId   String
  payRun     PayRun   @relation(fields: [payRunId], references: [xeroId], onDelete: Cascade)
  employeeId String
  gross      Decimal  @db.Decimal(12, 2)
  super      Decimal  @db.Decimal(12, 2)
  hours      Decimal  @db.Decimal(10, 2)
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
}

// ---------- Front ----------

/// Client-service effort: tickets per client per month (matched by the client's email domains).
model FrontTicketMonth {
  clientId String
  month    String
  tickets  Int
  updatedAt DateTime @updatedAt

  @@id([clientId, month])
}

/// Client rate per service (until CLM is connected: entered here or imported; then read from CLM).
model ClientRate {
  clientId    String
  serviceCode String
  rate        Decimal  @db.Decimal(12, 4)
  /// MANUAL | IMPORT | CLM
  source      String   @default("MANUAL")
  validFrom   DateTime? @db.Date
  updatedAt   DateTime @updatedAt

  @@id([clientId, serviceCode])
}

// =====================================================================================
// Chunk 5 — leakage, rate checks, rate reviews, tasks and notifications
// =====================================================================================

/// Settings → Mapping: Xero item code on invoice lines → standard service (so billed can be compared per service).
model XeroItemMap {
  itemCode    String   @id
  serviceCode String?
  /// Postage, freight etc. — left out of processing comparisons
  excluded    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

enum LeakKind {
  UNDER_BILLING
  WEEKLY_MINIMUM
  RATE_MISMATCH
}

enum LeakStatus {
  OPEN
  TASK
  EXPLAINED
  RECOVERED
}

/// One finding. Detection runs are idempotent (key) and never overwrite a person's status or notes.
model LeakageItem {
  id               String     @id @default(cuid())
  /// kind|client|service|period — unique per finding
  key              String     @unique
  kind             LeakKind
  clientId         String
  serviceCode      String?
  /// YYYY-MM (month) or YYYY-Www (week)
  period           String
  expected         Decimal    @db.Decimal(14, 2)
  billed           Decimal    @db.Decimal(14, 2)
  gap              Decimal    @db.Decimal(14, 2)
  /// How it was worked out, in plain words with the numbers
  working          String
  status           LeakStatus @default(OPEN)
  cause            String?
  owner            String?
  note             String?
  foundOn          DateTime   @default(now())
  recoveredAmount  Decimal?   @db.Decimal(14, 2)
  recoveredInvoice String?
  recoveredOn      DateTime?  @db.Date
  recoveredBy      String?
  /// Imported from FA_Leakage_Log.xlsx
  imported         Boolean    @default(false)
  updatedAt        DateTime   @updatedAt

  @@index([status])
  @@index([clientId, period])
}

/// Rates as another system holds them (Dyspatch export, WMS rate export), for the CLM vs Dyspatch vs WMS checks.
model RateSnapshot {
  id          String   @id @default(cuid())
  /// DYSPATCH | WMS
  source      String
  clientId    String
  serviceCode String
  rate        Decimal  @db.Decimal(12, 4)
  asOf        DateTime @db.Date
  fileName    String?
  createdAt   DateTime @default(now())

  @@unique([source, clientId, serviceCode])
}

enum ReviewType {
  CPI
  CARRIER
  RENEWAL
  ADHOC
}

/// A rate review (brief §8): type, stage, owner, due date and the proposed rates.
model RateReview {
  id        String     @id @default(cuid())
  clientId  String
  type      ReviewType
  /// 0 Preparing · 1 Analysis · 2 Proposal · 3 Client negotiation · 4 Signed · 5 Rates in WMS & Dyspatch · 6 Checked on first invoice
  stage     Int        @default(0)
  owner     String?
  due       DateTime?  @db.Date
  note      String?
  /// { serviceCode: newRate }
  newRates  Json       @default("{}")
  target    Decimal?   @db.Decimal(5, 4)
  closed    Boolean    @default(false)
  createdBy String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([clientId])
}

enum TaskStatus {
  OPEN
  SNOOZED
  DONE
}

/// Follow-up tasks (brief §13). Resolve can be verified by API (verify) — failed check → snoozed 24 h.
model Task {
  id           String     @id @default(cuid())
  title        String
  detail       String?
  /// Where it's fixed: Xero, Dyspatch, WMS, Front, Analytics…
  where        String?
  link         String?
  clientId     String?
  owner        String?
  priority     String     @default("Normal")
  status       TaskStatus @default(OPEN)
  snoozedUntil DateTime?
  due          DateTime?  @db.Date
  /// Origin, e.g. leakage:<id>, notification:<id>, review:<id>
  source       String?
  /// { type: "xero-contact" | "xero-employee" | "staff-linked" | "client-linked" | …, …params }
  verify       Json?
  lastCheck    String?
  doneAt       DateTime?
  doneBy       String?
  doneNote     String?
  createdAt    DateTime   @default(now())

  @@index([status])
  @@index([source])
}

enum NoticeState {
  NEW
  DONE
  DISMISSED
}

/// What's new after a sync (brief §13): a staff member, client or supplier the app doesn't know yet.
model Notification {
  id        String      @id @default(cuid())
  /// NEW_STAFF | NEW_CLIENT | NEW_SUPPLIER | NEW_TENANT
  kind      String
  /// Stable key so the same thing is notified once, e.g. xero-employee:<id>
  key       String      @unique
  title     String
  detail    String?
  payload   Json?
  state     NoticeState @default(NEW)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([state])
}

// =====================================================================================
// Chunk 6 — contacts & recipients, reports, improvements, finance extras
// =====================================================================================

enum RecipientList {
  INTERNAL
  CLIENT
  LENDER
}

/// Settings → Contacts & recipients. Reports can be sent only to addresses on these lists (brief §10, §14).
model Recipient {
  id        String        @id @default(cuid())
  list      RecipientList
  name      String
  email     String
  /// CLIENT list: whose contact this is (Client-safe reports about that client only)
  clientId  String?
  /// LENDER list: bank, accountant, auditor, broker
  role      String?
  note      String?
  createdBy String
  createdAt DateTime      @default(now())

  @@unique([list, email])
}

/// A saved report (its own item in the Reports menu).
model Report {
  id         String    @id @default(cuid())
  name       String
  /// workload | trends | quarterly | yearly | volumes | protection | finance
  template   String
  /// WEEK | MONTH | QUARTER | YEAR
  period     String
  /// INTERNAL | CLIENT_SAFE | EXTERNAL
  cls        String    @default("INTERNAL")
  clientId   String?
  forecast   Boolean   @default(false)
  /// T | F | B — costing view(s) in the file; the other is left out completely
  costing    String    @default("B")
  /// OFF | WEEKLY | MONTHLY | QUARTERLY
  schedule   String    @default("OFF")
  sendTime   String    @default("07:30")
  /// DRY_RUN (to the owner only) | DRAFT (Front draft) | AUTO
  mode       String    @default("DRY_RUN")
  recipients String[]  @default([])
  approvedBy String?
  approvedAt DateTime?
  sortOrder  Int       @default(0)
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sends ReportSend[]
}

model ReportSend {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  mode      String
  to        String[]
  subject   String
  ok        Boolean
  /// Why it was blocked or failed (in plain words)
  error     String?
  frontId   String?
  by        String

  @@index([reportId, at])
}

// ---------- Finance (brief §9b) ----------

/// Balance sheet at each month end (Xero Reports/BalanceSheet, read-only)
model XeroBalance {
  month       String
  accountId   String
  accountCode String?
  accountName String
  /// Bank | Current Assets | Fixed Assets | Non-current Assets | Current Liabilities | Non-current Liabilities | Equity
  section     String
  amount      Decimal  @db.Decimal(14, 2)
  updatedAt   DateTime @updatedAt

  @@id([month, accountId])
}

/// Supplier bills (ACCPAY) — creditor days, aged payables, supplier prices for savings
model XeroBill {
  xeroId    String   @id
  number    String?
  reference String?
  contactId String
  date      DateTime @db.Date
  dueDate   DateTime? @db.Date
  status    String
  /// ex GST
  total     Decimal  @db.Decimal(14, 2)
  /// inc GST, what is still owed
  amountDue Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt

  lines XeroBillLine[]

  @@index([contactId, date])
  @@index([date])
}

model XeroBillLine {
  id          String   @id @default(cuid())
  billId      String
  bill        XeroBill @relation(fields: [billId], references: [xeroId], onDelete: Cascade)
  description String?
  itemCode    String?
  accountCode String?
  quantity    Decimal? @db.Decimal(14, 4)
  unitAmount  Decimal? @db.Decimal(14, 4)
  amount      Decimal  @db.Decimal(14, 2)

  @@index([billId])
  @@index([itemCode])
}

/// Debt schedule — entered by hand (not in Xero in this form)
model DebtFacility {
  id         String    @id @default(cuid())
  name       String
  lender     String?
  /// Limit / original amount
  limit      Decimal?  @db.Decimal(14, 2)
  balance    Decimal   @db.Decimal(14, 2)
  /// Interest rate per year (0.072 = 7.2%)
  rate       Decimal?  @db.Decimal(6, 4)
  /// Principal repaid per month
  principalMonthly Decimal @default(0) @db.Decimal(14, 2)
  endDate    DateTime? @db.Date
  security   String?
  note       String?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ---------- Improvements & savings (brief §9a) ----------

/// Categories (sub-categories inside); more can be added
model ImproveCategory {
  key       String   @id
  name      String
  subs      String[] @default([])
  sortOrder Int      @default(0)
}

/// One record from idea to verified initiative — it moves stage with its history, nothing retyped
model Improvement {
  id          String    @id @default(cuid())
  name        String
  description String?
  category    String
  sub         String?
  detail      String?
  /// process | supplier | materials | equipment | space | people
  changes     String[]  @default([])
  /// IDEA | PARKED | REJECTED | APPROVED | IN_PROGRESS | DONE | VERIFIED
  stage       String    @default("IDEA")
  /// Ideas
  reviewer    String?
  reviewDue   DateTime? @db.Date
  /// SHORT | LONG
  horizon     String    @default("SHORT")
  /// Initiatives: 1 = do first
  priority    Int?
  owner       String?
  startDate   DateTime? @db.Date
  dueDate     DateTime? @db.Date
  /// HARD | AVOIDANCE | SOFT (CIPS)
  savingType  String    @default("HARD")
  /// Calculation blocks: [{ kind, inputs }] — see lib/improve/calc.ts
  calc        Json      @default("[]")
  /// Estimated / measured saving per month (from the calc; measured after the change)
  estMonthly  Decimal?  @db.Decimal(14, 2)
  measuredMonthly Decimal? @db.Decimal(14, 2)
  /// Months of real data confirming the measured saving
  monthsConfirmed Int   @default(0)
  investment  Decimal?  @db.Decimal(14, 2)
  /// { service, clients[], site, supplierContactId, account, startDate }
  mapping     Json      @default("{}")
  /// Participant names (staff, with or without a login)
  participants String[] @default([])
  verifiedAt  DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  steps    ImproveStep[]
  comments ImproveComment[]

  @@index([stage])
}

model ImproveStep {
  id            String      @id @default(cuid())
  improvementId String
  improvement   Improvement @relation(fields: [improvementId], references: [id], onDelete: Cascade)
  name          String
  start         DateTime?   @db.Date
  due           DateTime?   @db.Date
  owner         String?
  /// NOT_STARTED | IN_PROGRESS | DONE
  status        String      @default("NOT_STARTED")
  /// "measure_after" triggers the saving recalculation
  kind          String?
  sortOrder     Int         @default(0)
  taskId        String?
  updatedAt     DateTime    @updatedAt

  @@index([improvementId])
}

model ImproveComment {
  id            String      @id @default(cuid())
  improvementId String
  improvement   Improvement @relation(fields: [improvementId], references: [id], onDelete: Cascade)
  by            String
  text          String
  at            DateTime    @default(now())
}

// ---------- Keys we give out (brief §12) ----------

/// An API key for another app (CLM, Accounts Hub, Marcus's app…). Only a hash is stored; the key is shown once.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  /// Shown in lists so a key can be recognised: "fa_live_ab12cd34…"
  prefix     String    @unique
  /// sha256 of the full key
  hash       String    @unique
  /// e.g. volumes:read, kpi:read, tasks:write — see lib/apikeys/scopes.ts
  scopes     String[]
  createdBy  String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  lastUsedIp String?
  uses       Int       @default(0)
  revokedAt  DateTime?
  revokedBy  String?
}
