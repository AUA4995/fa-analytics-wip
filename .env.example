# ---- Database (PostgreSQL) ----
# Local dev on Windows: PostgreSQL installed directly, own database (not the Accounts Hub one).
DATABASE_URL="postgresql://fa_analytics:choose-a-password@localhost:5432/fa_analytics?schema=public"

# ---- App ----
# Also the base of the links in invite / reset / access-request emails
APP_URL="http://localhost:3002"
# 32 random bytes, base64 — used to encrypt Xero tokens at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
# Sign-in secrets (Batch 2): encrypts 2FA secrets, keys backup-code hashes, signs the 8-hour "this device" cookie.
# Any random string of 32+ characters (same command as above works). If empty, TOKEN_ENCRYPTION_KEY is used instead;
# one of the two must be set or nobody can sign in. Keep it once set (changing it means everyone sets up 2FA again).
AUTH_SECRET=""

# ---- Xero — a separate app for Analytics at https://developer.xero.com/app/manage (read-only scopes only) ----
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3002/api/xero/callback"

# ---- Front — API token from a Front admin. Shared resources + messages:send, conversations read+write, messages read,
#      comments write, tags read+write, drafts write, events read, ticket statuses read ----
FRONT_API_TOKEN=""

# ---- Claude API (reading bill PDFs and attachments, report summaries) — own key for Analytics. Empty = AI off. ----
ANTHROPIC_API_KEY=""

# Only when the app runs behind a reverse proxy that sets X-Forwarded-For (not on the laptop or a plain Mac Mini
# install): 1 = trust that header for per-address sign-in and API limits. Unset = those limits are off; per-email,
# per-account and per-key limits always apply.
# TRUST_PROXY=1
